# Champz — copie para .env.local e preencha. NUNCA commitar valores reais.
# Na Vercel, cadastre em Settings > Environment Variables (Production e, se quiser, Preview).

# ── Banco (Neon) ──
# DATABASE_URL = conexão POOLED (runtime). A integração Neon/Vercel já cria esta.
# Migrações usam a conexão direta: DIRECT_URL, ou DATABASE_URL_UNPOOLED (criada pela integração Neon/Vercel).
# Local sem Neon: `npm run db:local` e use postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DIRECT_URL=

# ── Better Auth ──
# Segredo forte (ex.: openssl rand -base64 32). Obrigatório em produção; use valores diferentes em cada ambiente.
BETTER_AUTH_SECRET=
# URL pública. Local: http://localhost:3000 | Produção: https://champz-six.vercel.app
# Se vazia na Vercel, usa automaticamente o domínio de produção (VERCEL_PROJECT_PRODUCTION_URL).
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (opcional; login Google fica desativado sem estes valores) ──
# Callbacks autorizados no Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://champz-six.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Neon Object Storage (API S3) — bucket PRIVADO. Sem estes valores, uploads respondem 503. ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=champz-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── App ──
# Local: http://localhost:3000 | Produção: https://champz-six.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bootstrap do Superadmin (NÃO coloque aqui) ──
# SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD / SUPERADMIN_NAME / SUPERADMIN_USERNAME são definidos apenas
# na sessão do terminal ao rodar `npm run superadmin:bootstrap`. Nunca salve a senha em arquivo.
