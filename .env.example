# Champz — copie para .env.local e preencha. NUNCA commitar valores reais.

# Neon PostgreSQL: DATABASE_URL = conexão POOLED (runtime); DIRECT_URL = conexão direta (migrações).
# Local sem Neon: `npm run db:local` e use postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=
DIRECT_URL=

# Better Auth (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (opcional; login Google fica desativado sem estes valores)
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Object Storage (API S3) — bucket PRIVADO. Sem estes valores, uploads respondem 503.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=champz-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
